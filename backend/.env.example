# Modo seguro por defecto: modelo base con few-shot.
CHAMBA_PROVEEDOR=ollama
CHAMBA_MODO_ANALISIS=base
CHAMBA_MODELO_BASE=gemma4:e2b
CHAMBA_MODELO_VISION=gemma3:4b
CHAMBA_MODELO_ANALISIS=gemma4:e2b
CHAMBA_KEEP_ALIVE=10m
# FastAPI corre en WSL y Ollama en Windows.
OLLAMA_URL=http://172.26.176.1:11434
CHAMBA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloud Run con Gemma 4 hospedado mediante la Gemini API:
# CHAMBA_PROVEEDOR=gemini_api
# GEMMA_API_MODEL=gemma-4-26b-a4b-it
# GEMINI_API_KEY se inyecta desde Secret Manager; nunca se guarda aqui.

# Cuando el alias LoRA haya pasado las evaluaciones:
# CHAMBA_MODO_ANALISIS=lora
# CHAMBA_MODELO_ANALISIS=chamba-segura:e2b-lora
